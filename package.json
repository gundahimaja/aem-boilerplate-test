    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.31.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.8.1",
    "style-loader": "^3.3.4",
    "stylelint": "16.16.0",
    "stylelint-config-standard": "37.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "dependencies": {
    "lit": "^2.0.0",
    "webpack-stats-plugin": "^1.1.3"
  }
