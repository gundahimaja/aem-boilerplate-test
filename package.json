{
  "name": "@adobe/aem-sites-component",
  "version": "1.0.0",
  "description": "AEM Sites Web Component for Nest integration",
  "main": "build/release/bundle.js",
  "module": "build/release/bundle.js",
  "types": "types/index.d.ts",
  "files": [
    "build/release/",
    "types/"
  ],
  "repository": {
    "type": "git",
